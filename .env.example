APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CLIENT_PORTAL_URL=https://app.nrhintelligence.com

# Absolute path to the CLIENT portal's private storage (payment slips, receipts,
# candidate documents, client-captured consent). Defaults to ../nrh-intelligence/
# storage/app/private — set explicitly in production (shared mount).
CLIENT_STORAGE_PATH=

# Salt for hashid URL ids. Falls back to APP_KEY when empty — set a dedicated
# value in production so key rotation doesn't break every emailed/bookmarked URL.
# Once set, never change it.
HASHIDS_SALT=

# Shared PII encryption key for candidate identity_number (see config/pii.php).
# MUST be the SAME value in both nrh-admin and nrh-intelligence. Empty = OFF
# (plaintext, no behaviour change). Generate:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Once set, never change it. After setting in both apps, run: php artisan pii:backfill-identity
PII_KEY=

# Production session hardening (leave unset for local HTTP dev):
#   SESSION_SECURE_COOKIE=true   # cookies only over HTTPS
#   SESSION_ENCRYPT=true         # encrypt session payloads (rows share the PII database)
